│  │   │                                # User-defined. Never duplicated.      │
│  │   ├── shell/                       # TypeScript Astal v2 project          │
│  │   │   ├── theme.ts                 # TS theme tokens (mirrors theme.py)   │
│  │   │   ├── app.ts                   # Entry point                          │
│  │   │   └── widget/                  # Bar, Launcher, Notifications widgets │
