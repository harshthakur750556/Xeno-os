#!/usr/bin/env python3
import sys
import os
import socket
import json

def send_ipc(command, params=None):
    socket_path = os.environ.get("XENO_IPC_SOCKET")
    if not socket_path:
        print("Error: XENO_IPC_SOCKET environment variable not set", file=sys.stderr)
        sys.exit(1)
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.connect(socket_path)
        payload = {"command": command, "params": params or {}}
        s.sendall(json.dumps(payload).encode('utf-8'))
        s.shutdown(socket.SHUT_WR)
        resp_data = s.recv(262144)
        s.close()
        return json.loads(resp_data.decode('utf-8'))
    except Exception as e:
        print(f"Error connecting to IPC: {e}", file=sys.stderr)
        sys.exit(1)

def main():
    if len(sys.argv) < 2:
        print("Usage: xeno-notify [--send <title> <body> | --get-logs | --get-queue] [options]", file=sys.stderr)
        sys.exit(1)
    
    arg = sys.argv[1]
    if arg == "--send":
        if len(sys.argv) < 4:
            print("Error: --send requires title and body", file=sys.stderr)
            sys.exit(1)
        title = sys.argv[2]
        body = sys.argv[3]
        
        # Parse options
        urgency = "normal"
        sound = ""
        timeout = 3000
        
        idx = 4
        while idx < len(sys.argv):
            opt = sys.argv[idx]
            if opt == "--urgency" and idx + 1 < len(sys.argv):
                urgency = sys.argv[idx+1]
                idx += 2
            elif opt == "--sound" and idx + 1 < len(sys.argv):
                sound = sys.argv[idx+1]
                idx += 2
            elif opt == "--timeout" and idx + 1 < len(sys.argv):
                try:
                    timeout = int(sys.argv[idx+1])
                except ValueError:
                    pass
                idx += 2
            else:
                idx += 1
                
        res = send_ipc("notification:send", {
            "title": title,
            "body": body,
            "urgency": urgency,
            "sound": sound,
            "timeout": timeout
        })
        if res.get("status") == "success":
            print(f"Notification Sent [ID: {res['id']}]")
        else:
            print(f"Error: {res.get('message')}", file=sys.stderr)
            sys.exit(1)
            
    elif arg == "--get-logs":
        res = send_ipc("notification:get_logs")
        if res.get("status") == "success":
            for log in res["logs"]:
                print(log)
        else:
            print(f"Error: {res.get('message')}", file=sys.stderr)
            sys.exit(1)
            
    elif arg == "--get-queue":
        res = send_ipc("notification:get_queue")
        if res.get("status") == "success":
            for n in res["notifications"]:
                urg = n.get('urgency', 'normal')
                snd = n.get('sound') or 'none'
                timeout = n.get('timeout', 3000)
                print(f"[{n['id']}] {n['title']}: {n['body']} (Urgency: {urg}, Sound: {snd}, Timeout: {timeout}ms)")
        else:
            print(f"Error: {res.get('message')}", file=sys.stderr)
            sys.exit(1)
    elif arg == "--dismiss":
        if len(sys.argv) < 3:
            print("Error: --dismiss requires an ID", file=sys.stderr)
            sys.exit(1)
        try:
            notif_id = int(sys.argv[2])
        except ValueError:
            print("Error: ID must be an integer", file=sys.stderr)
            sys.exit(1)
        res = send_ipc("notification:dismiss", {"id": notif_id})
        if res.get("status") == "success":
            print(f"Notification {notif_id} dismissed")
        else:
            print(f"Error: {res.get('message')}", file=sys.stderr)
            sys.exit(1)
    else:
        print(f"Unknown option: {arg}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
