#!/usr/bin/env python3
import sys
import os
import socket
import json

def send_ipc(command, params=None):
    socket_path = os.environ.get("XENO_IPC_SOCKET")
    if not socket_path:
        print("Error: XENO_IPC_SOCKET environment variable not set", file=sys.stderr)
        sys.exit(1)
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.connect(socket_path)
        payload = {"command": command, "params": params or {}}
        s.sendall(json.dumps(payload).encode('utf-8'))
        s.shutdown(socket.SHUT_WR)
        chunks = []
        while True:
            chunk = s.recv(65536)
            if not chunk:
                break
            chunks.append(chunk)
        resp_data = b"".join(chunks)
        s.close()
        return json.loads(resp_data.decode('utf-8'))
    except Exception as e:
        print(f"Error connecting to IPC: {e}", file=sys.stderr)
        sys.exit(1)

def main():
    if len(sys.argv) < 2:
        print("Usage: xeno-status-bar [--get-clock | --get-cpu | --get-ram | --get-workspaces | --toggle-launcher]", file=sys.stderr)
        sys.exit(1)
    
    arg = sys.argv[1]
    if arg == "--get-clock":
        res = send_ipc("status_bar:get_clock")
        if res.get("status") == "success":
            print(res["clock"])
        else:
            print(f"Error: {res.get('message')}", file=sys.stderr)
            sys.exit(1)
    elif arg == "--get-cpu":
        res = send_ipc("status_bar:get_cpu")
        if res.get("status") == "success":
            cpu = res["cpu"]
            print(f"CPU: {cpu}%")
        else:
            print(f"Error: {res.get('message')}", file=sys.stderr)
            sys.exit(1)
    elif arg == "--get-ram":
        res = send_ipc("status_bar:get_ram")
        if res.get("status") == "success":
            ram = res["ram"]
            print(f"RAM: {ram['used']}GB / {ram['total']}GB ({ram['percent']}%)")
        else:
            print(f"Error: {res.get('message')}", file=sys.stderr)
            sys.exit(1)
    elif arg == "--get-workspaces":
        res = send_ipc("status_bar:get_workspaces")
        if res.get("status") == "success":
            w = res["workspaces"]
            act = res["active"]
            w_str = ", ".join(f"[{x}]" if x == act else str(x) for x in w)
            print(f"Workspaces: {w_str}")
        else:
            print(f"Error: {res.get('message')}", file=sys.stderr)
            sys.exit(1)
    elif arg == "--toggle-launcher":
        res = send_ipc("status_bar:toggle_launcher")
        if res.get("status") == "success":
            print(f"Launcher toggled: {res['launcher_visible']}")
        else:
            print(f"Error: {res.get('message')}", file=sys.stderr)
            sys.exit(1)
    else:
        print(f"Unknown option: {arg}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
