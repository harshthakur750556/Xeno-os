#!/usr/bin/env python3
import sys
import os
import socket
import json

def send_ipc(command, params=None):
    socket_path = os.environ.get("XENO_IPC_SOCKET")
    if not socket_path:
        print("Error: XENO_IPC_SOCKET environment variable not set", file=sys.stderr)
        sys.exit(1)
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.connect(socket_path)
        payload = {"command": command, "params": params or {}}
        s.sendall(json.dumps(payload).encode('utf-8'))
        s.shutdown(socket.SHUT_WR)
        chunks = []
        while True:
            chunk = s.recv(65536)
            if not chunk:
                break
            chunks.append(chunk)
        resp_data = b"".join(chunks)
        s.close()
        return json.loads(resp_data.decode('utf-8'))
    except Exception as e:
        print(f"Error connecting to IPC: {e}", file=sys.stderr)
        sys.exit(1)

def print_usage():
    print("Usage: xeno-sandbox [--start | --stop | --status | --load-panel <panel>] [options]", file=sys.stderr)
    print("Options:", file=sys.stderr)
    print("  --memory <limit>    Specify memory limit (e.g. 2GB, 512MB)", file=sys.stderr)
    print("  --threads <count>   Specify max thread allocation", file=sys.stderr)

def main():
    if len(sys.argv) < 2:
        print_usage()
        sys.exit(1)
    
    # Check for invalid flags (parameter validation)
    allowed_flags = {"--start", "--stop", "--status", "--load-panel", "--memory", "--threads"}
    for arg in sys.argv[1:]:
        if arg.startswith("-") and arg not in allowed_flags:
            print(f"Error: Invalid flag {arg}", file=sys.stderr)
            print_usage()
            sys.exit(1)

    cmd = sys.argv[1]
    
    if cmd == "--start":
        memory = "2GB"
        threads = 2
        
        idx = 2
        while idx < len(sys.argv):
            opt = sys.argv[idx]
            if opt == "--memory" and idx + 1 < len(sys.argv):
                memory = sys.argv[idx+1]
                idx += 2
            elif opt == "--threads" and idx + 1 < len(sys.argv):
                try:
                    threads = int(sys.argv[idx+1])
                except ValueError:
                    print("Error: --threads requires an integer", file=sys.stderr)
                    sys.exit(1)
                idx += 2
            else:
                idx += 1
                
        res = send_ipc("sandbox:start", {"memory": memory, "threads": threads})
        if res.get("status") == "success":
            print("Sandbox started successfully.")
        else:
            print(f"Error: {res.get('message')}", file=sys.stderr)
            msg = res.get('message', '')
            if "collision" in msg:
                sys.exit(2)
            elif "Resource limits" in msg:
                sys.exit(3)
            else:
                sys.exit(1)
                
    elif cmd == "--stop":
        res = send_ipc("sandbox:stop")
        if res.get("status") == "success":
            print("Sandbox stopped successfully.")
        else:
            print(f"Error: {res.get('message')}", file=sys.stderr)
            sys.exit(1)
            
    elif cmd == "--status":
        res = send_ipc("sandbox:status")
        if res.get("status") == "success":
            running = "Running" if res["running"] else "Stopped"
            print(f"Sandbox Status: {running}")
            print(f"Memory Limit: {res['memory_limit']}")
            print(f"Threads: {res['threads']}/{res['max_threads']}")
            print(f"Panels: {', '.join(res['panels'])}")
        else:
            print(f"Error: {res.get('message')}", file=sys.stderr)
            sys.exit(1)
            
    elif cmd == "--load-panel":
        if len(sys.argv) < 3:
            print("Error: --load-panel requires a panel name", file=sys.stderr)
            sys.exit(1)
        panel = sys.argv[2]
        res = send_ipc("sandbox:load_panel", {"panel": panel})
        if res.get("status") == "success":
            print(f"Panel {panel} loaded successfully.")
        else:
            print(f"Error: {res.get('message')}", file=sys.stderr)
            sys.exit(1)
    else:
        print(f"Unknown command: {cmd}", file=sys.stderr)
        print_usage()
        sys.exit(1)

if __name__ == "__main__":
    main()
