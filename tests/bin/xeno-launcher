#!/usr/bin/env python3
import sys
import os
import socket
import json

def send_ipc(command, params=None):
    socket_path = os.environ.get("XENO_IPC_SOCKET")
    if not socket_path:
        print("Error: XENO_IPC_SOCKET environment variable not set", file=sys.stderr)
        sys.exit(1)
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.connect(socket_path)
        payload = {"command": command, "params": params or {}}
        s.sendall(json.dumps(payload).encode('utf-8'))
        s.shutdown(socket.SHUT_WR)
        chunks = []
        while True:
            chunk = s.recv(65536)
            if not chunk:
                break
            chunks.append(chunk)
        resp_data = b"".join(chunks)
        s.close()
        return json.loads(resp_data.decode('utf-8'))
    except Exception as e:
        print(f"Error connecting to IPC: {e}", file=sys.stderr)
        sys.exit(1)

def main():
    if len(sys.argv) < 2:
        print("Usage: xeno-launcher [--list-apps | --launch <app_id> | --get-state | --press-shortcut]", file=sys.stderr)
        sys.exit(1)
    
    arg = sys.argv[1]
    if arg == "--list-apps":
        res = send_ipc("launcher:list_apps")
        if res.get("status") == "success":
            apps = res["apps"]
            if not apps:
                print("Applications grid: empty")
            else:
                for app in apps:
                    print(f"[{app['id']}] {app['name']} - {app['command']} ({app['icon']})")
        else:
            print(f"Error: {res.get('message')}", file=sys.stderr)
            sys.exit(1)
    elif arg == "--launch":
        if len(sys.argv) < 3:
            print("Error: --launch requires an application ID", file=sys.stderr)
            sys.exit(1)
        app_id = sys.argv[2]
        res = send_ipc("launcher:launch", {"app_id": app_id})
        if res.get("status") == "success":
            print(f"Launched application: {res['launched']}")
        else:
            print(f"Error: {res.get('message')}", file=sys.stderr)
            sys.exit(1)
    elif arg == "--get-state":
        res = send_ipc("launcher:get_state")
        if res.get("status") == "success":
            print(f"Highlighted: {res['highlighted_index']}, Font: {res['font_family']} {res['font_size']}px, Visible: {res['visible']}")
        else:
            print(f"Error: {res.get('message')}", file=sys.stderr)
            sys.exit(1)
    elif arg == "--press-shortcut":
        res = send_ipc("launcher:press_shortcut")
        if res.get("status") == "success":
            print(f"Launcher toggled via shortcut: {res['launcher_visible']}")
        else:
            print(f"Error: {res.get('message')}", file=sys.stderr)
            sys.exit(1)
    else:
        print(f"Unknown option: {arg}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
