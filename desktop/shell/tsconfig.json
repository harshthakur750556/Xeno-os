{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "jsxFactory": "JSX.createElement",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "astal": ["./libs/astal"],
      "astal/gtk3": ["./libs/astal-gtk3"],
      "@astal/gtk3": ["./libs/astal-gtk3"],
      "*": ["*", "node_modules/*"]
    }
  },
  "include": [
    "app.ts",
    "theme.ts",
    "Bar.ts",
    "Launcher.ts",
    "Notifications.ts",
    "state.ts",
    "declarations.d.ts",
    "libs/astal/index.d.ts",
    "libs/astal-gtk3/index.d.ts"
  ]
}
